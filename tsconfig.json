{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "skipLibCheck": true
  },
  "include": ["src", "tests"],
  "exclude": ["dist", "storage"]
}

